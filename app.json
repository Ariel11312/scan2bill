{
  "expo": {
    "owner": "ariel082s-team",
    "name": "Scan2Bill",
    "slug": "meterscan",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.example.meterscan",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan2Bill uses the camera to read your electric meter."
      }
    },
"android": {
  "package": "com.ariel082.scan2bill",
  "permissions": [
    "android.permission.CAMERA"
  ]
},
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Scan2Bill uses the camera to read your electric meter."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "219b9589-5e69-4d78-910a-25c3153c0657"
      }
    }
  }
}