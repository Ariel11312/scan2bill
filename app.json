{
  "expo": {
    "owner": "ariel082s-team",
    "name": "Scan2Bill",
    "slug": "meterscan",
    "scheme": "scan2bill",
    "version": "1.0.4",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ariel082.scan2bill",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan2Bill uses the camera to read your electric meter."
      }
    },
    "android": {
      "package": "com.ariel082.scan2bill",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Scan2Bill uses the camera to read your electric meter."
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "27.1.12297006",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "219b9589-5e69-4d78-910a-25c3153c0657"
      }
    }
  }
}